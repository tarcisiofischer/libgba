#!/usr/bin/env python3
"""
Convert monogram-bitmap.png into a GBA 4bpp tileset header (.inc).

The monogram font layout:
  - Each character cell is 6x12 pixels (5px glyph + 1px gap, 7px tall + padding)
  - 16 characters per row, 8 rows = 128 characters total
  - Characters start at ASCII 0x20 (space)
  - Each character is converted to an 8x8 GBA tile (4bpp, 16 colors)
  - Palette index 0 = transparent/background, 1 = foreground

Usage:
  python3 font2tiles.py <input.png> <output.inc>
"""

import sys
import argparse
from PIL import Image


CHARS_PER_ROW = 16
CHAR_CELL_W = 6   # stride between characters in x
CHAR_CELL_H = 12  # stride between characters in y
GLYPH_W = 5       # actual glyph pixel width
GLYPH_H = 7       # actual glyph pixel height
ASCII_START = 0x20  # space

# The font sheet has a 1px top/left border before glyphs start
SHEET_X_OFFSET = 1   # first glyph starts at x=1 (not x=0)
SHEET_Y_OFFSET = 2   # first row group starts at y=2 (not y=0)

TILE_W = 8
TILE_H = 8


def extract_glyph(img, char_index):
    """Extract a single glyph as a list of rows, each row a list of booleans."""
    row_in_sheet = char_index // CHARS_PER_ROW
    col_in_sheet = char_index % CHARS_PER_ROW

    # Row groups start at y=SHEET_Y_OFFSET, with stride CHAR_CELL_H
    # Columns start at x=SHEET_X_OFFSET, with stride CHAR_CELL_W
    x0 = SHEET_X_OFFSET + col_in_sheet * CHAR_CELL_W
    y0 = SHEET_Y_OFFSET + row_in_sheet * CHAR_CELL_H

    glyph = []
    for dy in range(GLYPH_H):
        row = []
        for dx in range(GLYPH_W):
            x = x0 + dx
            y = y0 + dy
            if x < img.width and y < img.height:
                pixel = img.getpixel((x, y))
                # RGBA: non-transparent = foreground
                row.append(pixel[3] > 128)
            else:
                row.append(False)
        glyph.append(row)
    return glyph


def glyph_to_tile_data(glyph):
    """
    Convert a 5x7 glyph to an 8x8 GBA 4bpp tile (16 u16 values).
    4bpp: each u16 holds 4 pixels (4 bits each), low nibble = leftmost pixel.
    Palette index 0 = background, 1 = foreground.
    Returns list of 16 u16 values (one per pair of pixel rows in 8x8 tile).
    """
    # Build 8x8 pixel grid (pad glyph to 8x8)
    pixels = [[0] * TILE_W for _ in range(TILE_H)]
    for y in range(min(GLYPH_H, TILE_H)):
        for x in range(min(GLYPH_W, TILE_W)):
            if y < len(glyph) and x < len(glyph[y]):
                pixels[y][x] = 1 if glyph[y][x] else 0

    # Encode to 4bpp: each u16 covers 4 pixels (one u16 per 4 pixels in a row)
    # An 8x8 tile at 4bpp = 8 rows * 2 u16s per row = 16 u16s
    words = []
    for row in pixels:
        # Each row of 8 pixels -> 2 u16 words (4 pixels per word)
        for chunk_start in range(0, TILE_W, 4):
            chunk = row[chunk_start:chunk_start + 4]
            # Low nibble = pixel 0 (leftmost), high nibble per nibble position
            word = (chunk[0] & 0xF) | ((chunk[1] & 0xF) << 4) | \
                   ((chunk[2] & 0xF) << 8) | ((chunk[3] & 0xF) << 12)
            words.append(word)
    return words  # 16 u16 values


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", help="Input PNG (monogram-bitmap.png)")
    parser.add_argument("output", help="Output .inc file")
    args = parser.parse_args()

    img = Image.open(args.input).convert("RGBA")

    num_chars = CHARS_PER_ROW * (img.height // CHAR_CELL_H)
    print(f"Image: {img.width}x{img.height}, extracting {num_chars} chars "
          f"starting at ASCII {ASCII_START} ('{chr(ASCII_START)}')")

    lines = []
    lines.append("// Auto-generated by font2tiles.py — do not edit")
    lines.append("// Monogram bitmap font as GBA 4bpp 8x8 tiles")
    lines.append("// Palette: index 0 = background, index 1 = foreground")
    lines.append(f"// First tile = ASCII {ASCII_START} (space), "
                 f"tile_index = ascii_code - {ASCII_START}")
    lines.append("")
    lines.append("static const u16_t FONT_PALETTE[] = {")
    lines.append("  0x0000,  // index 0: transparent (black background)")
    lines.append("  0x7FFF,  // index 1: white foreground")
    lines.append("};")
    lines.append("static const u16_t FONT_PALETTE_SIZE = 2;")
    lines.append("")
    lines.append(f"static const u16_t FONT_ASCII_START = {ASCII_START};")
    lines.append(f"static const u16_t FONT_NUM_CHARS = {num_chars};")
    lines.append("")
    lines.append("// 16 u16 words per tile (8x8 @ 4bpp)")
    lines.append("static const u16_t FONT_TILESET[] = {")

    total_words = 0
    for i in range(num_chars):
        char_ascii = ASCII_START + i
        char_display = chr(char_ascii) if 32 <= char_ascii < 127 else f"0x{char_ascii:02X}"
        glyph = extract_glyph(img, i)
        words = glyph_to_tile_data(glyph)
        hex_words = ", ".join(f"0x{w:04X}" for w in words)
        lines.append(f"  {hex_words},  // [{i}] ASCII {char_ascii} '{char_display}'")
        total_words += len(words)

    lines.append("};")
    lines.append(f"static const u16_t FONT_TILESET_SIZE = {total_words};")
    lines.append("")

    with open(args.output, "w") as f:
        f.write("\n".join(lines))

    print(f"Written {num_chars} tiles ({total_words} u16 words) to {args.output}")


if __name__ == "__main__":
    main()
